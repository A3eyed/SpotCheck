{
  "expo": {
    "name": "SpotCheck",
    "slug": "spotcheck-ghana",
    "description": "Ghana's trusted rental and hospitality marketplace. Developed by Abdallah Fuseini.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "privacy": "public",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spotcheck"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.spotcheck"
    },
    "plugins": [
      ["expo-router", { "sitemap": false }],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
